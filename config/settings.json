{
  "language": "en-US",
  "stt_languages": ["en-US"],
  "stt_try_all_languages": true,
  "listen_timeout_seconds": 3,
  "phrase_time_limit_seconds": 7,
  "ambient_calibration_seconds": 0.4,
  "calibrate_microphone_once": true,
  "pause_threshold_seconds": 0.8,
  "microphone_index": "auto",
  "assistant_name": "Jarvis",
  "voice_enabled": true,
  "tts_engine": "sapi",
  "tts_reinitialize_each_call": true,
  "stt_engine": "speech_recognition",
  "wake_word_enabled": true,
  "wake_word": "hei jarvis",
  "wake_word_aliases": ["hei jarvis", "hey jarvis", "hai jarvis", "hi jarvis", "jarvis", "hei jervis", "hey jervis", "jervis", "hey travis", "hey service", "hey jarves", "hey jars"],
  "wake_word_fuzzy": true,
  "wake_prompt_response": "what do you need sir",
  "command_ack_response": "as your command",
  "confirm_sensitive_actions": true,
  "log_commands": true,
  "use_ai_parser": true,
  "ai_parser_only_for_unknown": true,
  "ai_parser_after_wake_only": true,
  "gemini_timeout_seconds": 2,
  "long_text_confirmation_chars": 120,
  "search_in_current_website": true,
  "search_in_same_tab": true,
  "spotify_autoplay": true,
  "spotify_play_backend": "desktop_first",
  "spotify_play_wait_seconds": 4,
  "spotify_desktop_wait_seconds": 3,
  "spotify_first_result_click_x_ratio": 0.35,
  "spotify_first_result_click_y_ratio": 0.36
}
